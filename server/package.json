{
  "name": "preppulse-server",
  "version": "1.0.0",
  "description": "Backend API for PrepPulse interview preparation platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{js,json}\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "preppulse",
    "interview-prep",
    "express",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
