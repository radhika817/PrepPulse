# Server Port (default: 5000)
PORT=5000

# Node Environment: 'development', 'production', or 'test'
NODE_ENV=development

# MongoDB Connection String
# - For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/preppulse?retryWrites=true&w=majority
# - For local MongoDB: mongodb://localhost:27017/preppulse
# - If left empty in development: automatically falls back to an in-memory database
MONGO_URI=mongodb://localhost:27017/preppulse

# Secret key for signing JSON Web Tokens (JWT)
# In production (NODE_ENV=production), this MUST be at least 32 characters long
JWT_SECRET=your_jwt_secret_key_change_in_production_minimum_32_characters_long

# JWT token expiration duration (e.g. '7d', '24h')
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS (comma-separated list supported for preview deployments)
# e.g. http://localhost:5173 or https://preppulse.vercel.app,https://preppulse-preview.vercel.app
CLIENT_URL=http://localhost:5173
